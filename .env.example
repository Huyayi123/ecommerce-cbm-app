VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CRON_SECRET=your-random-cron-secret

# Vercel Serverless 环境变量，不要加 VITE_，避免暴露到浏览器
TAKEALOT_API_BASE_URL=https://seller-api.takealot.com
TAKEALOT_INVENTORY_PATH=/v2/offers
TAKEALOT_STORES_JSON=[{"name":"Bestby","apiKeyEnv":"TAKEALOT_API_KEY_BESTBY"},{"name":"Arfast","apiKeyEnv":"TAKEALOT_API_KEY_ARFAST"},{"name":"Aicom","apiKeyEnv":"TAKEALOT_API_KEY_AICOM"},{"name":"MegaValue","apiKeyEnv":"TAKEALOT_API_KEY_MEGAVALUE"},{"name":"KeepFit","apiKeyEnv":"TAKEALOT_API_KEY_KEEPFIT"},{"name":"Lifon","apiKeyEnv":"TAKEALOT_API_KEY_LIFON"},{"name":"PatPaw","apiKeyEnv":"TAKEALOT_API_KEY_PATPAW"}]
TAKEALOT_API_KEY_SHOP_1=your-takealot-api-key
TAKEALOT_API_KEY_SHOP_2=your-takealot-api-key
TAKEALOT_API_KEY_BESTBY=your-takealot-api-key
TAKEALOT_API_KEY_ARFAST=your-takealot-api-key
TAKEALOT_API_KEY_AICOM=your-takealot-api-key
TAKEALOT_API_KEY_MEGAVALUE=your-takealot-api-key
TAKEALOT_API_KEY_KEEPFIT=your-takealot-api-key
TAKEALOT_API_KEY_LIFON=your-takealot-api-key
TAKEALOT_API_KEY_PATPAW=your-takealot-api-key
TAKEALOT_MAX_PAGES=50
TAKEALOT_SYNC_STORES=MegaValue,KeepFit
TAKEALOT_REPRICING_MAX_PAGES=50
